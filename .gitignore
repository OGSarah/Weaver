# Node dependencies. The lockfile (web/package-lock.json) is committed instead, so
# installs are reproducible without carrying the tree itself.
node_modules/

# Build output: the bundle and the assets esbuild emits beside it. Not committed,
# because the Dockerfile's web stage builds them, so a fresh clone still needs no
# Node toolchain to get a working UI out of `docker compose up --build`.
web/dist/

# macOS directory metadata.
.DS_Store

# Local environment overrides.
.env
.env.local
